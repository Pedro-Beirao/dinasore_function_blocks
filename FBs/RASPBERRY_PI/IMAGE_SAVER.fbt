<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE FBType SYSTEM "http://www.holobloc.com/xml/LibraryElement.dtd">
<FBType Name="IMAGE_SAVER" OpcUa="SERVICE">
    <InterfaceList>
        <EventInputs>
            <Event Name="INIT" Type="Event"/>
            <Event Name="SAVE" Type="Event">
                <With Var="Image"/>
                <With Var="Path"/>
            </Event>
        </EventInputs>
        <EventOutputs>
            <Event Name="INIT_O" Type="Event"/>
            <Event Name="SAVE_O" Type="Event">
                <With Var="Status"/>
            </Event>
        </EventOutputs>
        <InputVars>
            <VarDeclaration Name="Image" Type="STRING" Comment="Encoded image"/>
            <VarDeclaration Name="Path" Type="STRING"/>
        </InputVars>
        <OutputVars>
            <VarDeclaration Name="Status" Type="STRING"/>
        </OutputVars>
    </InterfaceList>
</FBType>
